#!/usr/bin/env python3

import sys
import subprocess
from pathlib import Path

# Find the directory containing this file
BASE_DIR = Path(__file__).resolve().parent

# Map commands to existing scripts
COMMANDS = {
    "show-p": "show-projects.py",
    "new-p": "new-project.py",
    "projects": "list_projects.py",
    "edit-p": "edit-projects.py",
}


def main():
    if len(sys.argv) == 1 or sys.argv[1] in ("--help", "-h", "help"):
        print("Usage: nova <command> [arguments]")
        print("Commands: show, np, list, edit")
        return 0

    command = sys.argv[1]

    if command not in COMMANDS:
        print(f"Unknown command: {command}", file=sys.stderr)
        print("Available commands: show, np, list, edit")
        return 2

    script = BASE_DIR / COMMANDS[command]

    if not script.is_file():
        print(f"Script not found: {script}", file=sys.stderr)
        return 1

    # Forward all remaining arguments to the selected script
    result = subprocess.run(
        [sys.executable, str(script), *sys.argv[2:]],
        cwd=BASE_DIR,
    )

    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
